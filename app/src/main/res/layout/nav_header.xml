<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:background="@color/inst_blue"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Fila superior: logo + nombre app -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Escudo sobre fondo blanco circular -->
        <androidx.cardview.widget.CardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="36dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_secretaria"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:contentDescription="Escudo Secretaría" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EcoGestión"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Secretaría de Ambiente"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="y Economía Circular"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Línea divisora -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4DFFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp" />

    <!-- Nombre del usuario logueado -->
    <TextView
        android:id="@+id/navHeaderNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Administrador"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Rol del usuario logueado -->
    <TextView
        android:id="@+id/navHeaderRol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Administrador"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />

</LinearLayout>

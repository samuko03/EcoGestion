<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/gray_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/inst_blue"
        app:titleTextColor="@color/white"
        app:title="Reportes"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generá reportes en PDF para compartir o imprimir."
                android:textSize="13sp"
                android:textColor="@color/gray_hint"
                android:layout_marginBottom="16dp" />

            <!-- Resumen General -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊  Resumen General"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/carbon_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Totales de zonas, plantaciones, especies y tareas con sus estados."
                        android:textSize="12sp"
                        android:textColor="@color/gray_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReporteGeneral"
                        style="@style/EcoButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Generar PDF" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Plantaciones -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌱  Reporte de Plantaciones"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/carbon_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Listado completo de plantaciones con zona, especie, cantidad y estado."
                        android:textSize="12sp"
                        android:textColor="@color/gray_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportePlantaciones"
                        style="@style/EcoButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Generar PDF" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tareas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✔  Reporte de Tareas"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/carbon_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Todas las tareas ordenadas por prioridad con estado y responsable."
                        android:textSize="12sp"
                        android:textColor="@color/gray_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReporteTareas"
                        style="@style/EcoButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Generar PDF" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Por Zona -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗺  Reporte por Zona"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/carbon_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Plantaciones y tareas agrupadas por zona de trabajo."
                        android:textSize="12sp"
                        android:textColor="@color/gray_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReporteZonas"
                        style="@style/EcoButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Generar PDF" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Reporte Gráfico -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈  Reporte Gráfico"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/carbon_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Gráfico de barras por zona y torta por estado, con filtro de fechas."
                        android:textSize="12sp"
                        android:textColor="@color/gray_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReporteGrafico"
                        style="@style/EcoButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver gráficos" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nombre + stock chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtNombreEspecie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quebracho Colorado"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/carbon_text" />

            <TextView
                android:id="@+id/txtStockEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISPONIBLE"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/white"
                android:background="@drawable/bg_estado_activa" />

        </LinearLayout>

        <!-- Nombre científico -->
        <TextView
            android:id="@+id/txtNombreCientifico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Schinopsis balansae"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="@color/gray_hint" />

        <!-- Ecorregión y stock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/txtEcorregion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ecorregión: Chaco Seco"
                android:textSize="12sp"
                android:textColor="@color/gray_hint" />

            <TextView
                android:id="@+id/txtStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150 plantines"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/green_primary" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@color/gray_divider" />

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarEspecie"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="@color/inst_blue"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/inst_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarEspecie"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eliminar"
                android:textColor="@color/error_red"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/error_red" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>

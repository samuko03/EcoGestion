<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EcoGestion"
        tools:targetApi="31">

        <!-- Clave de Google Maps — reemplazá YOUR_MAPS_API_KEY con tu clave real -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyAtAauBHtS-G4sd8T-ectWvZomY1IIy2rc" />

        <!-- Splash: launcher principal -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.EcoGestion.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ZonasActivity"
            android:exported="false" />
        <activity
            android:name=".activities.FormZonaActivity"
            android:exported="false" />
        <activity
            android:name=".activities.EspeciesActivity"
            android:exported="false" />
        <activity
            android:name=".activities.FormEspecieActivity"
            android:exported="false" />
        <activity
            android:name=".activities.UsuariosActivity"
            android:exported="false" />
        <activity
            android:name=".activities.FormUsuarioActivity"
            android:exported="false" />
        <activity
            android:name=".activities.PlantacionesActivity"
            android:exported="false" />
        <activity
            android:name=".activities.FormPlantacionActivity"
            android:exported="false" />
        <activity
            android:name=".activities.TareasActivity"
            android:exported="false" />
        <activity
            android:name=".activities.FormTareaActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ReportesActivity"
            android:exported="false" />
        <activity
            android:name=".activities.SeleccionarUbicacionActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ReporteGraficoActivity"
            android:exported="false" />
        <activity
            android:name=".activities.AuditoriaActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
